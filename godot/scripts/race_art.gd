class_name RaceArt
extends Node

# Gameplay uses committed sprite atlases generated by bake_race_art.gd.
# No model construction, GPU readback or texture uploads during a race.
# The render helper remains available to the offline builder and visual QA.
const SPRITES_PATH := "res://art/race/sprites.gd"

const MODEL := preload("res://scripts/car_model.gd")

# Big enough for a crisp sprite on a 1080p phone (the crop keeps only the car,
# ~55% of the frame), small enough that a bake is cheap. Most sprites are drawn
# at ~130 px wide, so 240 px of budget is already oversampling.
const VP_W := 240
const VP_H := 360
const ORTHO := 5.35

var _vp: SubViewport
var _cam: Camera3D
var _model

# signature -> shared atlas texture and source rectangle
var _cache: Dictionary = {}
var _pages: Array = []

# Load only when 3D is selected; the caller enables this before the race.
func set_enabled(enabled: bool) -> void:
	if not enabled:
		_cache.clear()
		_pages.clear()
		return
	if not _pages.is_empty():
		return
	var sprites = load(SPRITES_PATH)
	for path: String in sprites.PAGES:
		_pages.append(load(path))
	for key: String in sprites.ENTRIES:
		var entry: Array = sprites.ENTRIES[key]
		_cache[key] = {"page": int(entry[0]),
			"region": Rect2(entry[1], entry[2], entry[3], entry[4]),
			"w": int(entry[3]), "h": int(entry[4])}


func _build() -> void:
	_vp = SubViewport.new()
	_vp.name = "RaceArtView"
	_vp.size = Vector2i(VP_W, VP_H)
	_vp.transparent_bg = true
	_vp.own_world_3d = true
	_vp.msaa_3d = Viewport.MSAA_2X
	_vp.gui_disable_input = true
	_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
	add_child(_vp)

	var we := WorldEnvironment.new()
	var env := Environment.new()
	env.background_mode = Environment.BG_CLEAR_COLOR
	env.background_color = Color(0, 0, 0, 0)
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(0.60, 0.65, 0.72)
	env.ambient_light_energy = 0.30
	env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.tonemap_exposure = 1.02
	we.environment = env
	_vp.add_child(we)

	# High key, because the chase camera sees mostly the roof and the bonnet.
	var key := DirectionalLight3D.new()
	_vp.add_child(key)
	key.rotation_degrees = Vector3(-62.0, 34.0, 0.0)
	key.light_energy = 0.72
	key.light_color = Color(1.0, 0.97, 0.92)

	var fill := DirectionalLight3D.new()
	_vp.add_child(fill)
	fill.rotation_degrees = Vector3(-28.0, -68.0, 0.0)
	fill.light_energy = 0.20
	fill.light_color = Color(0.72, 0.82, 1.0)

	var rim := DirectionalLight3D.new()
	_vp.add_child(rim)
	rim.rotation_degrees = Vector3(-20.0, 202.0, 0.0)
	rim.light_energy = 0.34
	rim.light_color = Color(0.95, 0.96, 1.0)

	_cam = Camera3D.new()
	_cam.projection = Camera3D.PROJECTION_ORTHOGONAL
	_cam.size = ORTHO
	_cam.position = Vector3(0.0, 4.60, -3.00)
	_vp.add_child(_cam)
	_cam.look_at(Vector3(0.0, 0.65, 0.30), Vector3.UP)
	_cam.current = true

	_model = MODEL.new()
	_model.name = "Car"
	_vp.add_child(_model)


# --- public API -------------------------------------------------------------

# Unknown appearances keep the existing 2D fallback, without starting a bake.
func take(car: Dictionary) -> Dictionary:
	return _cache.get(_key(car), {})


# Draws a cached sprite centred in a w x h box, keeping the model's aspect.
func draw(ci: CanvasItem, center: Vector2, w: float, h: float, sprite: Dictionary, modulate := Color.WHITE) -> void:
	var sw := float(sprite.w)
	var sh := float(sprite.h)
	if sw < 1.0 or sh < 1.0:
		return
	var k := minf(h * 0.96 / sh, w * 0.99 / sw)
	var size := Vector2(sw, sh) * k
	ci.draw_texture_rect_region(_pages[int(sprite.page)], Rect2(center - size * 0.5, size),
		sprite.region, modulate)


# QA hook: render straight away and hand back the cropped image.
func render_preview(car: Dictionary) -> Image:
	if _vp == null:
		_build()
	return await _render(_clean(car))


func cached_count() -> int:
	return _cache.size()


func _render(car: Dictionary) -> Image:
	if _vp == null or _model == null:
		return null
	_model.show_car(car)
	_frame_model(str(car.get("silhouette", "sedan")))
	# Render exactly once: UPDATE_ONCE schedules the draw for this frame, and
	# frame_post_draw fires after it lands. The old UPDATE_ALWAYS + two-frame
	# dance cost a second full 3D pass per bake for nothing.
	_vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	await RenderingServer.frame_post_draw
	var img := _vp.get_texture().get_image()
	if img == null:
		return null
	_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
	img.convert(Image.FORMAT_RGBA8)
	var bb := _alpha_bounds(img)
	if bb.size.x < 4 or bb.size.y < 4:
		return null
	return img.get_region(bb)


func _frame_model(sil: String) -> void:
	# Commercial bodies need a taller bake and a fitted camera: the passenger
	# car's fixed frustum clips both ends of a coach before the alpha crop.
	var commercial := sil in ["truck", "bus"]
	_vp.size = Vector2i(320, 760) if commercial else Vector2i(VP_W, VP_H)
	_cam.size = ORTHO
	if not commercial:
		_cam.position = Vector3(0.0, 4.60, -3.00)
		_cam.look_at(Vector3(0.0, 0.65, 0.30), Vector3.UP)
		return
	var bb: AABB = _model.bounds()
	var center := bb.get_center()
	_cam.position = center + Vector3(0, 11.85, -9.90)
	_cam.look_at(center, Vector3.UP)
	var fit := 1.0
	for i in range(8):
		var p := _cam.unproject_position(bb.get_endpoint(i))
		fit = maxf(fit, absf(p.x / _vp.size.x - 0.5) * 2.0 / 0.90)
		fit = maxf(fit, absf(p.y / _vp.size.y - 0.5) * 2.0 / 0.90)
	_cam.size *= fit


# Tight crop around the car. The scan is strided: a pixel of extra margin is
# invisible at gameplay size, and a full-resolution walk would cost a hitch on
# every new traffic colour.
func _alpha_bounds(img: Image) -> Rect2i:
	var w := img.get_width()
	var h := img.get_height()
	if w < 2 or h < 2:
		return Rect2i()
	var data := img.get_data()
	var step := 2
	var minx := w
	var miny := h
	var maxx := -1
	var maxy := -1
	for y in range(0, h, step):
		var row := y * w * 4
		for x in range(0, w, step):
			if data[row + x * 4 + 3] > 8:
				if x < minx:
					minx = x
				if x > maxx:
					maxx = x
				if y < miny:
					miny = y
				if y > maxy:
					maxy = y
	if maxx < minx or maxy < miny:
		return Rect2i()
	minx = maxi(0, minx - step)
	miny = maxi(0, miny - step)
	maxx = mini(w - 1, maxx + step)
	maxy = mini(h - 1, maxy + step)
	return Rect2i(minx, miny, maxx - minx + 1, maxy - miny + 1)


# --- keys -------------------------------------------------------------------

func _key(car: Dictionary) -> String:
	var sil := _silhouette(car)
	if sil == "":
		return ""
	return "%s|%s|%s|%s|%s|%s" % [
		sil,
		Color(car.get("color", Color("#b32b26"))).to_html(),
		str(bool(car.get("stripe", false))),
		Color(car.get("stripe_color", Color("#f0ede4"))).to_html() if car.get("stripe", false) else "",
		Color(car.get("trailer", Color("#d9dad6"))).to_html() if sil == "truck" else "",
		Color(car.get("accent", Color("#d64a3a"))).to_html() if sil == "bus" else "",
	]


func _clean(car: Dictionary) -> Dictionary:
	return {
		"silhouette": _silhouette(car),
		"color": Color(car.get("color", Color("#b32b26"))).to_html(),
		"stripe": bool(car.get("stripe", false)),
		"stripe_color": Color(car.get("stripe_color", Color("#f0ede4"))).to_html(),
		"trailer": Color(car.get("trailer", Color("#d9dad6"))).to_html(),
		"accent": Color(car.get("accent", Color("#d64a3a"))).to_html(),
	}


# Traffic kinds borrow the garage classes; a silhouette already set by the
# spawner wins. Every one of the seven traffic kinds has a 3D silhouette.
func _silhouette(car: Dictionary) -> String:
	var s := str(car.get("silhouette", ""))
	if MODEL.SPECS.has(s):
		return s
	match int(car.get("kind", 0)):
		1:
			return "offroad"
		2:
			return "truck"
		3:
			return "van"
		4:
			return "bus"
		5:
			return "sport"
		6:
			return "pickup"
		0:
			return "sedan"
	return ""
