extends Node

# Offline lamp-anchor builder (0.8.0 follow-up). Measures where the lamps of
# every car class really are, so headlights, stop lights and indicators sit
# exactly on the lenses in both art modes:
#   3D: every emissive lamp mesh (white / red / amber material) of the race
#       model is projected through the bake camera into the cropped sprite.
#       Front lamps hidden from the chase camera still project correctly.
#   2D: the painted car is rendered into a SubViewport in a neutral body
#       colour; head- and tail-lamp pixels are found by colour, indicators sit
#       on the body edge at lamp height.
# Writes res://art/race/lamps.gd. Coordinates are normalised to the sprite
# (3D) or the drawing box (2D): 0..1, origin top-left, nose at the top.
# Needs a graphical renderer:
#   godot --path godot res://tests/BakeRaceLamps.tscn -- --bake-race-lamps
const ART = preload("res://scripts/race_art.gd")
const PALETTE = preload("res://scripts/traffic_palette.gd")
const OUT := "res://art/race/lamps.gd"

# Traffic kind -> box scale (Game.TRAFFIC_TYPES) and silhouettes it can take.
const KINDS := {
	0: [1.00, 1.00, ["hatch", "sedan", "ev"]],
	1: [1.06, 1.08, ["offroad"]],
	2: [1.14, 1.72, ["truck"]],
	3: [1.04, 1.38, ["van"]],
	4: [1.12, 2.05, ["bus"]],
	5: [1.05, 0.96, ["sport", "muscle", "hyper"]],
	6: [1.05, 1.16, ["pickup"]],
}
const CAR_W := 86.1
const CAR_H := 163.6

var table_3d: Dictionary = {}
var table_2d: Dictionary = {}


func _ready() -> void:
	call_deferred("_run")


func _run() -> void:
	if not "--bake-race-lamps" in OS.get_cmdline_user_args():
		push_error("Pass -- --bake-race-lamps to regenerate lamp anchors")
		get_tree().quit(1)
		return
	var sils: Array = []
	for c: Dictionary in Cars.LIST:
		if not sils.has(str(c.silhouette)):
			sils.append(str(c.silhouette))
	for s: String in PALETTE.SILHOUETTES:
		if not sils.has(s):
			sils.append(s)
	var art := ART.new()
	add_child(art)
	art.set_process(false)
	await get_tree().process_frame
	for sil: String in sils:
		table_3d[sil] = await _measure_3d(art, sil)
		print("[lamps] 3D ", sil, " ", table_3d[sil])
	# 2D: traffic per kind/silhouette, and the player's painted cars.
	for kind: int in KINDS:
		var cfg: Array = KINDS[kind]
		for sil: String in cfg[2]:
			table_2d["%d|%s" % [kind, sil]] = await _measure_2d(kind, sil, CAR_W * float(cfg[0]), CAR_H * float(cfg[1]), false)
	for c: Dictionary in Cars.LIST:
		var key := "player|%s" % str(c.silhouette)
		if not table_2d.has(key):
			table_2d[key] = await _measure_2d(0, str(c.silhouette), CAR_W, CAR_H, true)
	for k in table_2d:
		print("[lamps] 2D ", k, " ", table_2d[k])
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("# Generated by bake_race_lamps.gd; regenerate after changing car models or art.gd.\n")
	f.store_string("# Lamp anchors, normalised 0..1 (x right, y down, nose at the top):\n")
	f.store_string("# head/tail/ind_f/ind_r = [left_x, left_y, right_x, right_y].\nextends RefCounted\n\n")
	f.store_string("const LAMPS_3D = " + JSON.stringify(table_3d, "\t", true) + "\n\n")
	f.store_string("const LAMPS_2D = " + JSON.stringify(table_2d, "\t", true) + "\n")
	f.close()
	print("[lamps] Done: ", table_3d.size(), " 3D silhouettes, ", table_2d.size(), " 2D layouts")
	get_tree().quit()


func _round(v: Vector2) -> Array:
	return [snappedf(v.x, 0.001), snappedf(v.y, 0.001)]


func _pairs(groups: Dictionary) -> Dictionary:
	var out := {}
	for cat in ["head", "tail", "ind_f", "ind_r"]:
		var l: Array = groups.get(cat + "_l", [])
		var r: Array = groups.get(cat + "_r", [])
		if l.is_empty() or r.is_empty():
			continue
		var lp := _centroid(l)
		var rp := _centroid(r)
		out[cat] = _round(lp) + _round(rp)
	return out


func _centroid(pts: Array) -> Vector2:
	var sum := Vector2.ZERO
	var wsum := 0.0
	for p in pts:
		sum += Vector2(p[0], p[1]) * float(p[2])
		wsum += float(p[2])
	return sum / maxf(wsum, 0.0001)


func _measure_3d(art, sil: String) -> Dictionary:
	var car := {"silhouette": sil, "color": "#808080", "stripe": false}
	if art._vp == null:
		art._build()
	var clean: Dictionary = art._clean(car)
	art._model.show_car(clean)
	art._frame_model(sil)
	art._vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	await RenderingServer.frame_post_draw
	var img: Image = art._vp.get_texture().get_image()
	img.convert(Image.FORMAT_RGBA8)
	var bb: Rect2i = art._alpha_bounds(img)
	art._vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
	var m = art._model
	var mats := {m._lamp_w: "w", m._lamp_r: "r", m._lamp_a: "a"}
	var root: Node3D = m
	var bounds: AABB = m.bounds() if m.has_method("bounds") else AABB()
	var half_len := maxf(bounds.size.z, 1.0) * 0.5
	var groups := {}
	for mi in m.find_children("*", "MeshInstance3D", true, false):
		var kind = mats.get(mi.material_override, "")
		if kind == "":
			continue
		var aabb: AABB = mi.get_aabb()
		var world: Vector3 = mi.global_transform * aabb.get_center()
		var local: Vector3 = root.global_transform.affine_inverse() * world
		var rel_z := (local.z - bounds.get_center().z) / half_len
		# Skip centre lamps (third brake light, plate lamp), side markers and
		# the roof clearance lamps of trucks and buses: indicators, head and
		# tail lamps all sit at bumper / body height.
		if absf(local.x) < 0.12 or absf(rel_z) < 0.55 or local.y > 1.8:
			continue
		var px: Vector2 = art._cam.unproject_position(world)
		var n := Vector2((px.x - bb.position.x) / float(bb.size.x), (px.y - bb.position.y) / float(bb.size.y))
		var wgt := maxf(aabb.size.x * aabb.size.y + aabb.size.x * aabb.size.z, 0.0001)
		var front := rel_z > 0.0
		var cat := ""
		match kind:
			"w":
				cat = "head" if front else ""
			"r":
				cat = "tail" if not front else ""
			"a":
				cat = "ind_f" if front else "ind_r"
		if cat == "":
			continue
		var key: String = cat + ("_l" if n.x < 0.5 else "_r")
		if not groups.has(key):
			groups[key] = []
		groups[key].append([n.x, n.y, wgt])
	var out := _pairs(groups)
	# Classes without amber lenses: indicators at the outer edge of the lamps.
	if out.has("head") and not out.has("ind_f"):
		var h: Array = out.head
		out["ind_f"] = [snappedf(maxf(0.04, float(h[0]) - 0.07), 0.001), h[1], snappedf(minf(0.96, float(h[2]) + 0.07), 0.001), h[3]]
	if out.has("tail") and not out.has("ind_r"):
		var t: Array = out.tail
		out["ind_r"] = [snappedf(maxf(0.04, float(t[0]) - 0.05), 0.001), t[1], snappedf(minf(0.96, float(t[2]) + 0.05), 0.001), t[3]]
	return out


func _measure_2d(kind: int, sil: String, w: float, h: float, player: bool) -> Dictionary:
	var vp := SubViewport.new()
	vp.size = Vector2i(int(w) + 40, int(h) + 40)
	vp.transparent_bg = true
	vp.disable_3d = true
	vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	add_child(vp)
	var center := Vector2(vp.size) * 0.5
	var layer := DrawLayer.new("Car", 0, func(ci: CanvasItem) -> void:
		var body := Color(0.10, 0.55, 0.12)
		if player:
			Art.car(ci, center, w, h, body, {"player": true, "stripe": false, "wing": false,
				"silhouette": sil, "brake": false, "light": 0.0})
		else:
			Art.traffic(ci, center, w, h, kind, body, {"silhouette": sil, "exact": true,
				"brake": false, "light": 0.0, "stripe": false}))
	vp.add_child(layer)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var img := vp.get_texture().get_image()
	vp.queue_free()
	img.convert(Image.FORMAT_RGBA8)
	var head_c := Color(0.97, 0.95, 0.86)
	var tail_c := Color(0.86, 0.13, 0.12) if player else Color(0.78, 0.11, 0.11)
	var groups := {}
	var x0 := center.x - w * 0.5
	var y0 := center.y - h * 0.5
	var edge_l := {}
	var edge_r := {}
	for y in range(img.get_height()):
		for x in range(img.get_width()):
			var c := img.get_pixel(x, y)
			if c.a < 0.5:
				continue
			var ny := (float(y) - y0) / h
			var nx := (float(x) - x0) / w
			if not edge_l.has(y):
				edge_l[y] = nx
			edge_r[y] = nx
			var cat := ""
			if ny < 0.35 and _near(c, head_c, 0.10):
				cat = "head"
			elif ny > 0.65 and _near(c, tail_c, 0.12):
				cat = "tail"
			if cat == "":
				continue
			var key: String = cat + ("_l" if nx < 0.5 else "_r")
			if not groups.has(key):
				groups[key] = []
			groups[key].append([nx, ny, 1.0])
	var out := _pairs(groups)
	# Painted vans, pickups and buses have no drawn headlamps: put them on the
	# front corners of the body, just inside the outline.
	if not out.has("head") and not edge_l.is_empty():
		var top_row: int = edge_l.keys().min() + int(h * 0.025)
		var le: float = edge_l.get(top_row, 0.1)
		var re: float = edge_r.get(top_row, 0.9)
		var ny := snappedf((float(top_row) - y0) / h, 0.001)
		out["head"] = [snappedf(le + 0.13, 0.001), ny, snappedf(re - 0.13, 0.001), ny]
	# Indicators: on the body edge at lamp height.
	for pair in [["head", "ind_f"], ["tail", "ind_r"]]:
		if not out.has(pair[0]):
			continue
		var p: Array = out[pair[0]]
		var row := int(round(y0 + float(p[1]) * h))
		var le: float = edge_l.get(row, float(p[0]) - 0.08)
		var re: float = edge_r.get(row, float(p[2]) + 0.08)
		out[pair[1]] = [snappedf(le + 0.04, 0.001), p[1], snappedf(re - 0.04, 0.001), p[3]]
	return out


func _near(a: Color, b: Color, tol: float) -> bool:
	return absf(a.r - b.r) < tol and absf(a.g - b.g) < tol and absf(a.b - b.b) < tol
