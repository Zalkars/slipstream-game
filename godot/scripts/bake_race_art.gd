extends SceneTree

# Offline sprite atlas builder. Run with a graphical Compatibility renderer:
# godot --path godot --script res://scripts/bake_race_art.gd -- --bake-race-art
const ART = preload("res://scripts/race_art.gd")
const PALETTE = preload("res://scripts/traffic_palette.gd")
const SIZE := 2048
const PAD := 4
var atlas: Image
var entries: Dictionary = {}
var pages: Array = []
var cursor := Vector2i(PAD, PAD)
var row_height := 0

func _initialize() -> void:
	call_deferred("_run")

func _save_page() -> void:
	var path := "res://art/race/cars_%d.png" % pages.size()
	var used_height := mini(SIZE, nearest_po2(cursor.y + row_height + PAD))
	atlas = atlas.get_region(Rect2i(0, 0, SIZE, used_height))
	assert(atlas.save_png(ProjectSettings.globalize_path(path)) == OK)
	# Newly added atlas pages must use the same filtering as existing pages.
	if not FileAccess.file_exists(path + ".import"):
		var settings := FileAccess.open(path + ".import", FileAccess.WRITE)
		settings.store_string('[remap]\nimporter="texture"\ntype="CompressedTexture2D"\n\n[deps]\nsource_file="%s"\n\n[params]\ncompress/mode=0\nmipmaps/generate=true\nmipmaps/limit=2\nprocess/fix_alpha_border=true\n' % path)
		settings.close()
	pages.append(path)
	atlas = Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	cursor = Vector2i(PAD, PAD)
	row_height = 0

func _run() -> void:
	if not "--bake-race-art" in OS.get_cmdline_user_args():
		push_error("Pass -- --bake-race-art to regenerate committed race art")
		quit(1)
		return
	var art := ART.new()
	root.add_child(art)
	art.set_process(false)
	await process_frame
	var variants: Array = []
	variants.append_array(Cars.LIST)
	for sil: String in PALETTE.SILHOUETTES:
		for colour_index in range(PALETTE.TRAFFIC_COLORS.size()):
			variants.append_array(PALETTE.variants(sil, colour_index))
	atlas = Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	for car: Dictionary in variants:
		var key: String = art._key(car)
		if entries.has(key):
			continue
		var img: Image = await art.render_preview(car)
		if img == null:
			push_error("Blank sprite: " + key)
			quit(1)
			return
		var scale := minf(1.0, minf(128.0 / img.get_width(), 300.0 / img.get_height()))
		if scale < 1.0:
			img.resize(maxi(1, roundi(img.get_width() * scale)), maxi(1, roundi(img.get_height() * scale)), Image.INTERPOLATE_LANCZOS)
		var size := img.get_size()
		if cursor.x + size.x + PAD > SIZE:
			cursor.x = PAD
			cursor.y += row_height + PAD * 2
			row_height = 0
		if cursor.y + size.y + PAD > SIZE:
			_save_page()
		atlas.blit_rect(img, Rect2i(Vector2i.ZERO, size), cursor)
		entries[key] = [pages.size(), cursor.x, cursor.y, size.x, size.y]
		cursor.x += size.x + PAD * 2
		row_height = maxi(row_height, size.y)
		if entries.size() % 32 == 0:
			print("[bake] ", entries.size(), "/", variants.size())
	_save_page()
	var file := FileAccess.open("res://art/race/sprites.gd", FileAccess.WRITE)
	file.store_string("# Generated by bake_race_art.gd; regenerate after changing models or colours.\nextends RefCounted\n\nconst PAGES = [\n")
	for page: String in pages:
		file.store_string('\t"%s",\n' % page)
	file.store_string("]\n\nconst ENTRIES = " + JSON.stringify(entries, "\t", true) + "\n")
	file.close()
	print("[bake] Done: ", entries.size(), " sprites in ", pages.size(), " atlases")
	quit()
